{
  "uid": "odoo-operator",
  "title": "Odoo operator",
  "tags": [
    "odoo",
    "operator"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "options": []
      },
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(odoo_operator_deployment_info, namespace)",
          "refId": "namespace"
        },
        "definition": "label_values(odoo_operator_deployment_info, namespace)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      },
      {
        "name": "name",
        "label": "Instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(odoo_operator_deployment_info{namespace=~\"$namespace\"}, name)",
          "refId": "name"
        },
        "definition": "label_values(odoo_operator_deployment_info{namespace=~\"$namespace\"}, name)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "title": "Instances",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Pending",
      "description": "OdooDeployments in phase Pending.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(odoo_operator_deployment_phase{namespace=~\"$namespace\",name=~\"$name\",phase=\"Pending\"}) or vector(0)",
          "legendFormat": "",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "id": 2,
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "yellow"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "type": "stat",
      "title": "Initializing",
      "description": "OdooDeployments in phase Initializing.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(odoo_operator_deployment_phase{namespace=~\"$namespace\",name=~\"$name\",phase=\"Initializing\"}) or vector(0)",
          "legendFormat": "",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "id": 3,
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "type": "stat",
      "title": "Upgrading",
      "description": "OdooDeployments in phase Upgrading.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(odoo_operator_deployment_phase{namespace=~\"$namespace\",name=~\"$name\",phase=\"Upgrading\"}) or vector(0)",
          "legendFormat": "",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "id": 4,
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "purple"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "type": "stat",
      "title": "Running",
      "description": "OdooDeployments in phase Running.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(odoo_operator_deployment_phase{namespace=~\"$namespace\",name=~\"$name\",phase=\"Running\"}) or vector(0)",
          "legendFormat": "",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "id": 5,
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "type": "stat",
      "title": "Failed",
      "description": "OdooDeployments in phase Failed.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(odoo_operator_deployment_phase{namespace=~\"$namespace\",name=~\"$name\",phase=\"Failed\"}) or vector(0)",
          "legendFormat": "",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "id": 6,
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "type": "stat",
      "title": "Operator",
      "description": "1 while the operator's /metrics endpoint is being scraped (its up series).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(up{job=\"odoo-operator-controller-manager-metrics-service\"}) or vector(0)",
          "legendFormat": "",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "id": 7,
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Down",
                  "color": "red"
                },
                "1": {
                  "text": "Up",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "type": "table",
      "title": "OdooDeployments",
      "description": "One row per OdooDeployment. Ready pods come from kube-state-metrics.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (name, namespace, applied_image, image) (odoo_operator_deployment_info{namespace=~\"$namespace\",name=~\"$name\"})",
          "legendFormat": "",
          "refId": "info",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (name, namespace) (odoo_operator_deployment_phase{namespace=~\"$namespace\",name=~\"$name\",phase=\"Pending\"} * 1) or max by (name, namespace) (odoo_operator_deployment_phase{namespace=~\"$namespace\",name=~\"$name\",phase=\"Initializing\"} * 2) or max by (name, namespace) (odoo_operator_deployment_phase{namespace=~\"$namespace\",name=~\"$name\",phase=\"Upgrading\"} * 3) or max by (name, namespace) (odoo_operator_deployment_phase{namespace=~\"$namespace\",name=~\"$name\",phase=\"Running\"} * 4) or max by (name, namespace) (odoo_operator_deployment_phase{namespace=~\"$namespace\",name=~\"$name\",phase=\"Failed\"} * 5)",
          "legendFormat": "",
          "refId": "phase",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (name, namespace) (label_replace(kube_deployment_status_replicas_available, \"name\", \"$1\", \"deployment\", \"(.*)\")) and on (name, namespace) odoo_operator_deployment_info{namespace=~\"$namespace\",name=~\"$name\"}",
          "legendFormat": "",
          "refId": "ready",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (name, namespace) (odoo_operator_deployment_last_upgrade_duration_seconds{namespace=~\"$namespace\",name=~\"$name\"})",
          "legendFormat": "",
          "refId": "upgrade",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (name, namespace) (odoo_operator_deployment_database_ready{namespace=~\"$namespace\",name=~\"$name\"})",
          "legendFormat": "",
          "refId": "db",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "id": 8,
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Phase"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "1": {
                        "text": "Pending",
                        "color": "yellow",
                        "index": 0
                      }
                    }
                  },
                  {
                    "type": "value",
                    "options": {
                      "2": {
                        "text": "Initializing",
                        "color": "blue",
                        "index": 1
                      }
                    }
                  },
                  {
                    "type": "value",
                    "options": {
                      "3": {
                        "text": "Upgrading",
                        "color": "purple",
                        "index": 2
                      }
                    }
                  },
                  {
                    "type": "value",
                    "options": {
                      "4": {
                        "text": "Running",
                        "color": "green",
                        "index": 3
                      }
                    }
                  },
                  {
                    "type": "value",
                    "options": {
                      "5": {
                        "text": "Failed",
                        "color": "red",
                        "index": 4
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Last upgrade"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Database"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "Not ready",
                        "color": "red"
                      },
                      "1": {
                        "text": "Ready",
                        "color": "green"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          }
        ]
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "name": 0,
              "namespace": 1,
              "Value #phase": 2,
              "Value #ready": 3,
              "applied_image": 4,
              "image": 5,
              "Value #upgrade": 6,
              "Value #db": 7
            },
            "renameByName": {
              "name": "Name",
              "namespace": "Namespace",
              "Value #phase": "Phase",
              "Value #ready": "Ready pods",
              "applied_image": "Running image",
              "image": "Wanted image",
              "Value #upgrade": "Last upgrade",
              "Value #db": "Database"
            }
          }
        }
      ]
    },
    {
      "type": "row",
      "title": "Phases",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 13
      },
      "id": 9,
      "panels": []
    },
    {
      "type": "state-timeline",
      "title": "Phase per instance",
      "description": "Each OdooDeployment's status.phase over time; an upgrade shows as a purple band.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (name) (odoo_operator_deployment_phase{namespace=~\"$namespace\",name=~\"$name\",phase=\"Pending\"} * 1) or max by (name) (odoo_operator_deployment_phase{namespace=~\"$namespace\",name=~\"$name\",phase=\"Initializing\"} * 2) or max by (name) (odoo_operator_deployment_phase{namespace=~\"$namespace\",name=~\"$name\",phase=\"Upgrading\"} * 3) or max by (name) (odoo_operator_deployment_phase{namespace=~\"$namespace\",name=~\"$name\",phase=\"Running\"} * 4) or max by (name) (odoo_operator_deployment_phase{namespace=~\"$namespace\",name=~\"$name\",phase=\"Failed\"} * 5)",
          "legendFormat": "{{name}}",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "id": 10,
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "Pending",
                  "color": "yellow",
                  "index": 0
                }
              }
            },
            {
              "type": "value",
              "options": {
                "2": {
                  "text": "Initializing",
                  "color": "blue",
                  "index": 1
                }
              }
            },
            {
              "type": "value",
              "options": {
                "3": {
                  "text": "Upgrading",
                  "color": "purple",
                  "index": 2
                }
              }
            },
            {
              "type": "value",
              "options": {
                "4": {
                  "text": "Running",
                  "color": "green",
                  "index": 3
                }
              }
            },
            {
              "type": "value",
              "options": {
                "5": {
                  "text": "Failed",
                  "color": "red",
                  "index": 4
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "rowHeight": 0.8,
        "legend": {
          "showLegend": false
        }
      }
    },
    {
      "type": "row",
      "title": "Init and upgrade Jobs",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 23
      },
      "id": 11,
      "panels": []
    },
    {
      "type": "table",
      "title": "Running now",
      "description": "Jobs in flight and how long they have been running.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "time() - max by (name, kind) (odoo_operator_deployment_job_start_timestamp_seconds{namespace=~\"$namespace\",name=~\"$name\"})",
          "legendFormat": "",
          "refId": "A",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 24
      },
      "id": 12,
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "name": "Name",
              "kind": "Kind",
              "Value": "Running for"
            }
          }
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Finished Jobs",
      "description": "Init and upgrade Jobs by result, per hour. Counted once per Job.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (kind, result) (increase(odoo_operator_jobs_total{namespace=~\"$namespace\",name=~\"$name\"}[1h30s]))",
          "legendFormat": "{{kind}} {{result}}",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 24
      },
      "id": 13,
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal"
            }
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "interval": "1h",
      "maxDataPoints": 2000
    },
    {
      "type": "timeseries",
      "title": "Job duration",
      "description": "Duration of succeeded Jobs over the previous day, all instances.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.5, sum by (le, kind) (increase(odoo_operator_job_duration_seconds_bucket{result=\"succeeded\"}[1d])))",
          "legendFormat": "p50 {{kind}}",
          "refId": "A",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.95, sum by (le, kind) (increase(odoo_operator_job_duration_seconds_bucket{result=\"succeeded\"}[1d])))",
          "legendFormat": "p95 {{kind}}",
          "refId": "B",
          "range": true,
          "instant": false
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 24
      },
      "id": 14,
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Image pull failures",
      "description": "Times a new image could not be pulled (counted once per episode), per hour. On previews this usually means CI had not pushed the image yet.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (name) (increase(odoo_operator_image_pull_failures_total{namespace=~\"$namespace\",name=~\"$name\"}[1h30s]))",
          "legendFormat": "{{name}}",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "id": 15,
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80
          },
          "decimals": 0
        },
        "overrides": []
      },
      "interval": "1h",
      "maxDataPoints": 2000
    },
    {
      "type": "timeseries",
      "title": "Database operations",
      "description": "Databases created, adopted and dropped per hour, and failures.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (operation, result) (increase(odoo_operator_database_operations_total[1h30s])) > 0",
          "legendFormat": "{{operation}} {{result}}",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
