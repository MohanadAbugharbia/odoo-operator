<!doctype html>
<html lang="{{.Lang}}" dir="{{.Dir}}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex">
<meta name="color-scheme" content="light dark">
<title>{{.Title}}</title>
<noscript><meta http-equiv="refresh" content="30"></noscript>
<style>
:root {
  --accent: {{.Accent}};
  --bg: #f6f4f1; --card: #ffffff; --ink: #1f1a16; --muted: #6d645c; --line: #e9e3dc;
  --ok: #2f7d4f; --bad: #b3361f; --warn: #9a6a00;
  color-scheme: light dark;
}
@media (prefers-color-scheme: dark) {
  :root { --bg: #171411; --card: #211d19; --ink: #f1ebe4; --muted: #a89d92; --line: #362f29; --ok: #6cc08e; --bad: #f08a72; --warn: #e2b54a; }
}
* { box-sizing: border-box; }
html, body { margin: 0; min-height: 100%; }
body {
  background: var(--bg); color: var(--ink);
  font-family: system-ui, -apple-system, "Segoe UI", Roboto, "Noto Sans", "Noto Sans Arabic", Tahoma, sans-serif;
  font-size: 16px; line-height: 1.5;
  display: grid; place-items: center; min-height: 100vh; min-height: 100dvh; padding: 24px 16px;
}
main {
  width: 100%; max-width: 420px; background: var(--card); border: 1px solid var(--line); border-radius: 20px;
  padding: 32px 24px 26px; display: grid; gap: 16px; justify-items: center; text-align: center;
  box-shadow: 0 18px 40px -28px rgba(0, 0, 0, .35);
}
.mark {
  width: 56px; height: 56px; border-radius: 16px; background: var(--accent); color: #fff;
  display: grid; place-items: center; font-weight: 600; font-size: 26px; overflow: hidden;
}
.mark img { width: 100%; height: 100%; object-fit: contain; background: var(--card); }
h1 { margin: 0; font-size: 21px; line-height: 1.3; font-weight: 600; text-wrap: balance; }
ol { list-style: none; margin: 0; padding: 0; width: 100%; display: grid; gap: 10px; text-align: start; }
li { display: grid; grid-template-columns: 20px 1fr auto; gap: 10px; align-items: center; font-size: 15px; }
li .dot { width: 18px; height: 18px; border-radius: 50%; border: 2px solid var(--line); display: grid; place-items: center; font-size: 11px; line-height: 1; color: #fff; }
li.done .dot { background: var(--ok); border-color: var(--ok); }
li.now .dot { border-color: var(--accent); border-top-color: transparent; animation: spin 1s linear infinite; }
li.fail .dot { background: var(--bad); border-color: var(--bad); }
li.todo { color: var(--muted); }
li time { font-size: 13px; color: var(--muted); font-variant-numeric: tabular-nums; direction: ltr; unicode-bidi: isolate; }
.bar { width: 100%; height: 6px; border-radius: 3px; background: var(--line); overflow: hidden; position: relative; }
.bar i { position: absolute; inset-block: 0; inset-inline-start: 0; border-radius: 3px; background: var(--accent); transition: width .6s ease; }
.bar.indet i { width: 35%; opacity: .6; animation: slide 1.6s ease-in-out infinite; }
[dir="rtl"] .bar.indet i { animation-name: slide-rtl; }
@keyframes spin { to { transform: rotate(360deg); } }
@keyframes slide { from { transform: translateX(-100%); } to { transform: translateX(290%); } }
@keyframes slide-rtl { from { transform: translateX(100%); } to { transform: translateX(-290%); } }
@media (prefers-reduced-motion: reduce) {
  li.now .dot { animation: none; border-top-color: var(--accent); }
  .bar.indet i { animation: none; }
}
p { margin: 0; font-size: 14px; color: var(--muted); }
.alert { width: 100%; text-align: start; border-radius: 12px; padding: 10px 12px; font-size: 14px; color: var(--ink); }
.alert.bad { background: color-mix(in srgb, var(--bad) 13%, transparent); }
.alert.warn { background: color-mix(in srgb, var(--warn) 15%, transparent); }
.meta { width: 100%; border-top: 1px solid var(--line); padding-top: 10px; display: flex; flex-wrap: wrap; justify-content: space-between; gap: 4px 12px; font-size: 13px; color: var(--muted); }
.meta b { font-weight: 500; color: var(--ink); direction: ltr; unicode-bidi: isolate; }
[hidden] { display: none !important; }
</style>
</head>
<body>
<main aria-live="polite">
  <div class="mark" aria-hidden="true">{{if .Logo}}<img src="{{.Logo}}" alt="">{{else}}{{.Initial}}{{end}}</div>
  <h1 id="title">{{.Title}}</h1>
  <ol id="steps" hidden></ol>
  <div class="bar indet" id="bar"><i id="fill"></i></div>
  <div class="alert" id="alert" hidden></div>
  <p id="note"></p>
  <p id="stale" hidden></p>
  <div class="meta" id="meta" hidden>
    <span><span id="version-label"></span> <b id="version"></b></span>
    <span><span id="started-label"></span> <b id="started"></b></span>
  </div>
</main>
<script>
(function () {
  "use strict";
  var T = {{.Messages}};
  var LANG = {{.Lang}};
  var status = {{.Status}};
  var offset = 0;          // server clock minus this clock, in ms
  var lastFresh = Date.now();
  var POLL_MS = 3000, STALE_MS = 30000;

  function $(id) { return document.getElementById(id); }
  function clockSkew(s) { offset = new Date(s.now).getTime() - Date.now(); }
  function elapsedSeconds(s) {
    if (!s.startedAt) return null;
    return Math.max(0, Math.round((Date.now() + offset - new Date(s.startedAt).getTime()) / 1000));
  }
  function clock(sec) {
    var m = Math.floor(sec / 60), r = sec % 60;
    return m + ":" + (r < 10 ? "0" : "") + r;
  }
  function words(sec) {
    var m = Math.floor(sec / 60), r = sec % 60, out = [];
    if (m) out.push(m + " " + T.minutes);
    if (r || !m) out.push(r + " " + T.seconds);
    return out.join(" ");
  }
  function step(cls, label, time) {
    var li = document.createElement("li"), dot = document.createElement("span"), text = document.createElement("span");
    li.className = cls;
    dot.className = "dot";
    dot.textContent = cls === "done" ? "✓" : cls === "fail" ? "!" : "";
    text.textContent = label;
    li.appendChild(dot);
    li.appendChild(text);
    var t = document.createElement("time");
    t.textContent = time == null ? "" : clock(time);
    li.appendChild(t);
    return li;
  }

  function render() {
    var s = status, elapsed = elapsedSeconds(s), steps = [], title, note = "", alert = null;
    var bar = { show: true, width: null };
    switch (s.state) {
      case "preparing":
        title = T.setupTitle;
        steps = [["now", T.stepDb], ["todo", T.stepInstall], ["todo", T.stepStart]];
        note = T.firstNote;
        break;
      case "installing":
        title = T.setupTitle;
        steps = [["done", T.stepDb], ["now", T.stepInstall, elapsed], ["todo", T.stepStart]];
        note = T.firstNote;
        break;
      case "updating":
        title = T.updTitle;
        steps = [["done", T.stepDownload], ["now", T.stepUpdate, elapsed], ["todo", T.stepStart]];
        note = T.autoNote;
        if (s.expectedSeconds > 0) {
          var took = words(s.expectedSeconds);
          if (elapsed != null && elapsed > 2 * s.expectedSeconds) {
            alert = ["warn", T.slowNote.replace("{d}", took)];
            note = T.autoNote;
          } else {
            note = T.lastNote.replace("{d}", took);
            if (elapsed != null) bar.width = Math.min(95, Math.max(3, 100 * elapsed / s.expectedSeconds));
          }
        }
        break;
      case "failed":
        title = s.job === "upgrade" ? T.failTitle : T.failSetupTitle;
        steps = s.job === "upgrade"
          ? [["done", T.stepDownload], ["fail", T.stepUpdate]]
          : [["done", T.stepDb], ["fail", T.stepInstall]];
        alert = ["bad", T.failNote];
        note = T.failRetry;
        bar.show = false;
        break;
      case "unavailable":
        title = T.startTitle;
        note = T.unavailableNote;
        break;
      default: // starting
        title = T.startTitle;
        note = T.almostNote;
    }

    $("title").textContent = title;
    document.title = title;

    var ol = $("steps");
    while (ol.firstChild) ol.removeChild(ol.firstChild);
    steps.forEach(function (st) { ol.appendChild(step(st[0], st[1], st[2])); });
    ol.hidden = steps.length === 0;

    $("bar").hidden = !bar.show;
    $("bar").className = bar.width == null ? "bar indet" : "bar";
    $("fill").style.width = bar.width == null ? "" : bar.width + "%";

    $("alert").hidden = !alert;
    if (alert) { $("alert").className = "alert " + alert[0]; $("alert").textContent = alert[1]; }
    $("note").textContent = note;

    var stale = s.state !== "unavailable" && Date.now() - lastFresh > STALE_MS;
    $("stale").hidden = !stale;
    $("stale").textContent = stale ? T.unavailableNote : "";

    var showMeta = s.state === "updating" && (s.version || s.startedAt);
    $("meta").hidden = !showMeta;
    if (showMeta) {
      $("version-label").textContent = T.version;
      $("version").textContent = s.version || "";
      $("version-label").parentNode.hidden = !s.version;
      $("started-label").textContent = T.started;
      $("started").textContent = s.startedAt
        ? new Date(s.startedAt).toLocaleTimeString(LANG, { hour: "2-digit", minute: "2-digit" })
        : "";
      $("started-label").parentNode.hidden = !s.startedAt;
    }
  }

  // Odoo is back once /web/health answers: open the page that was asked for.
  function back() {
    if (location.hash) location.reload();
    else location.replace(location.href);
  }

  function poll() {
    fetch("/web/health", { cache: "no-store", credentials: "same-origin", redirect: "manual" })
      .then(function (r) { if (r.ok) back(); })
      .catch(function () {});
    fetch("{{.StatusPath}}", { cache: "no-store", credentials: "omit" })
      .then(function (r) { if (!r.ok) throw new Error(r.status); return r.json(); })
      .then(function (s) {
        clockSkew(s);
        if (!s.stale && s.state !== "unavailable") lastFresh = Date.now();
        status = s;
      })
      .catch(function () {})
      .then(render);
  }

  clockSkew(status);
  render();
  setInterval(render, 1000);
  setInterval(poll, POLL_MS);
})();
</script>
</body>
</html>
